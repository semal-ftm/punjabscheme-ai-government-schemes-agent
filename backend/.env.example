# Copy this file to backend/.env and fill in your own values. Never commit .env.

# --- LLM (DeepSeek) -----------------------------------------------------------
# Create a key at https://platform.deepseek.com/api_keys
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# Alternative provider: set LLM_PROVIDER=groq, GROQ_API_KEY=... and LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# --- Tavily live search (official domains only) --------------------------------
# Create a key at https://app.tavily.com . Searches are restricted to punjab.gov.pk, pspa.punjab.gov.pk,
# pessi.punjab.gov.pk, pwwf.punjab.gov.pk and bisp.gov.pk. Leave empty to disable live search.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

# --- RAG ----------------------------------------------------------------------
# Multilingual model so Urdu / Roman Urdu text is embedded meaningfully.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Crawler (be polite to government servers) --------------------------------
CRAWL_DELAY_SECONDS=2.0
CRAWL_TIMEOUT_SECONDS=25
CRAWL_MAX_PAGES_PER_SOURCE=30
CRAWL_MAX_PDFS_PER_SOURCE=8

# --- Scheduled update checks (APScheduler) -------------------------------------
ENABLE_SCHEDULER=true
UPDATE_INTERVAL_HOURS=24

# --- Web ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# Optional overrides (defaults live in backend/data/)
# DATA_DIR=
# DB_PATH=
# CHROMA_DIR=
# RULES_PATH=
# HF_HOME=   (embedding model cache; defaults to <project>/.cache/huggingface)
